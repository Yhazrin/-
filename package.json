{
  "name": "monument-valley-ecosystem-framework",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/**/*.test.js",
    "test:coverage": "npm run build && NODE_V8_COVERAGE=.coverage node --test tests/**/*.test.js",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\""
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
